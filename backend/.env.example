# PostgreSQL local para desarrollo. En AWS cambia la contraseña.
DB_NAME=pedidos360
DB_USER=pedidos360
DB_PASSWORD=pedidos360_local
DB_URL=jdbc:postgresql://database:5432/pedidos360

# Kafka 3 brokers localizados en la misma instancia de demostración
KAFKA_REPLICATION_FACTOR=3
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092

# RabbitMQ
RABBIT_USER=admin
RABBIT_PASSWORD=admin
RABBITMQ_ERLANG_COOKIE=pedidos360-shared-erlang-cookie
